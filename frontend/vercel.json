{
    "version": 2,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "headers": [
    {
      "source": "/(.)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }